APP_ENV=development
LISTEN_ADDR=127.0.0.1:8080
# Split-host local development through Caddy.
# Production uses phenogram.io, app.phenogram.io, and api.phenogram.io.
LANDING_BASE_URL=http://localhost
APP_BASE_URL=http://app.localhost
API_BASE_URL=http://api.localhost
DATABASE_URL=postgresql://phenogram:phenogram-development@localhost:5432/phenogram

# Generate independent values with: openssl rand -base64 32
MASTER_KEY=replace-with-at-least-32-random-characters
PUBLIC_ID_KEY=replace-with-another-32-random-characters
LINK_SIGNING_KEY=replace-with-a-third-32-random-characters

# Social sign-in only. Phenogram requests no email scope and stores no email.
# Use separate development OAuth clients with callbacks derived from APP_BASE_URL:
#   http://app.localhost/api/auth/oauth/google/callback
#   http://app.localhost/api/auth/oauth/github/callback
# Production callbacks must be exactly:
#   https://app.phenogram.io/api/auth/oauth/google/callback
#   https://app.phenogram.io/api/auth/oauth/github/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

TELEGRAM_CLOUD_API_URL=https://api.telegram.org
# Premium routing stays unavailable unless this points at an official local Bot API server.
TELEGRAM_LOCAL_API_URL=
# Mount the local Bot API data volume here to proxy absolute --local file paths.
TELEGRAM_LOCAL_DATA_DIR=
SESSION_TTL_HOURS=720
RETENTION_SWEEP_SECONDS=3600
RUST_LOG=phenogram_platform=info,tower_http=info

# Include http:// for Caddy's local sites; use bare DNS names in production.
PHENOGRAM_LANDING_DOMAIN=http://localhost
PHENOGRAM_APP_DOMAIN=http://app.localhost
PHENOGRAM_API_DOMAIN=http://api.localhost
