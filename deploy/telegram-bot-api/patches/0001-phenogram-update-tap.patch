+// Type 1 is a best-effort non-blocking observer. Type 2 is appended to a
+// bounded local TQueue only after native delivery handling and replayed with a
+// non-blocking ACK channel. Neither path may participate in canonical delivery.
+class UpdateTap final {
+ public:
+  static constexpr std::size_t HEADER_SIZE = 64;
+  static constexpr std::size_t MAX_DATAGRAM_SIZE = 32768;
+  static constexpr std::size_t MAX_FRAGMENT_PAYLOAD_SIZE = MAX_DATAGRAM_SIZE - HEADER_SIZE;
+  static constexpr std::size_t MAX_UPDATE_PAYLOAD_SIZE = 1 << 18;
+
+  static constexpr td::int64 MANAGED_LIFECYCLE_QUEUE_ID = -0x50475554LL;
+  static constexpr std::size_t MAX_MANAGED_LIFECYCLE_EVENTS = 10000;
+  static constexpr td::int32 MANAGED_LIFECYCLE_RETENTION_SECONDS = 7 * 86400;
+
+  explicit UpdateTap(td::string socket_path, td::string ack_socket_path = {}) noexcept;
+  UpdateTap(const UpdateTap &) = delete;
+  UpdateTap &operator=(const UpdateTap &) = delete;
+  UpdateTap(UpdateTap &&) = delete;
+  UpdateTap &operator=(UpdateTap &&) = delete;
+  ~UpdateTap();
+
+  void send_update(td::uint64 bot_id, bool is_test_dc, td::uint32 update_id, td::uint32 expires_at,
+                   td::Slice payload) noexcept;
+  void queue_managed_bot_lifecycle(td::TQueue &tqueue, td::int32 unix_time_now, double monotonic_now,
+                                   td::uint64 parent_bot_id, bool is_test_dc, td::uint64 owner_user_id,
+                                   td::uint64 child_bot_id) noexcept;
+  void replay_managed_bot_lifecycle(td::TQueue &tqueue, td::int32 unix_time_now, double monotonic_now) noexcept;
+
+  td::uint64 sent_event_count() const noexcept;
+  td::uint64 sent_datagram_count() const noexcept;
+  td::uint64 dropped_event_count() const noexcept;
+  td::uint64 error_count() const noexcept;
+  td::uint64 managed_lifecycle_persisted_count() const noexcept;
+  td::uint64 managed_lifecycle_acked_count() const noexcept;
+  td::uint64 managed_lifecycle_replayed_count() const noexcept;
+  td::uint64 managed_lifecycle_overflow_count() const noexcept;
+  td::uint64 managed_lifecycle_persistence_error_count() const noexcept;
+  td::uint64 managed_lifecycle_expired_count() const noexcept;
+  td::uint64 managed_lifecycle_ack_error_count() const noexcept;
+  std::size_t managed_lifecycle_pending_count(const td::TQueue &tqueue) const noexcept;
+
+ private:
