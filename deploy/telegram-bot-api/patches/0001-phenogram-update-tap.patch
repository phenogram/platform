+void test_gateway_drain_fence_orders_late_queries() {
+  telegram_bot_api::SharedData shared_data;
+  auto prod_id = shared_data.register_active_bot_query("123456:old-secret", false);
+  auto test_id = shared_data.register_active_bot_query("123456:old-secret", true);
+  assert(prod_id == 123456);
+  assert(test_id == 123456);
+  assert(shared_data.get_active_bot_query_count(prod_id, false) == 1);
+  assert(shared_data.get_active_bot_query_count(test_id, true) == 1);
+
+  assert(shared_data.install_gateway_drain_fence("123456:old-secret", false, 41) == prod_id);
+  assert(shared_data.is_gateway_query_fenced("123456:old-secret", false, 40));
+  assert(shared_data.is_gateway_query_fenced("123456:old-secret", false, 41));
+  assert(!shared_data.is_gateway_query_fenced("123456:old-secret", false, 42));
+  assert(!shared_data.is_gateway_query_fenced("123456:new-secret", false, 41));
+  assert(!shared_data.is_gateway_query_fenced("123456:old-secret", true, 41));
+
+  shared_data.unregister_active_bot_query(prod_id, false);
+  shared_data.unregister_active_bot_query(test_id, true);
+  assert(shared_data.get_active_bot_query_count(prod_id, false) == 0);
+  assert(shared_data.get_active_bot_query_count(test_id, true) == 0);
+}
+
+td::uint16 load_u16(const td::uint8 *source) {
+  return static_cast<td::uint16>((static_cast<td::uint16>(source[0]) << 8) | source[1]);
+}
+
+td::uint32 load_u32(const td::uint8 *source) {
+  return (static_cast<td::uint32>(source[0]) << 24) | (static_cast<td::uint32>(source[1]) << 16) |
+         (static_cast<td::uint32>(source[2]) << 8) | source[3];
+}
+
+td::uint64 load_u64(const td::uint8 *source) {
+  return (static_cast<td::uint64>(load_u32(source)) << 32) | load_u32(source + 4);
+}
+
+class UnixDatagramReceiver final {
+ public:
+  explicit UnixDatagramReceiver(std::string path, bool small_buffer = false) : path_(std::move(path)) {
+    unlink(path_.c_str());
+    fd_ = socket(AF_UNIX, SOCK_DGRAM, 0);
+    assert(fd_ >= 0);
+    int receive_buffer_size = small_buffer ? 4096 : 1 << 20;
+    assert(setsockopt(fd_, SOL_SOCKET, SO_RCVBUF, &receive_buffer_size, sizeof(receive_buffer_size)) == 0);
+    timeval timeout{1, 0};
+    assert(setsockopt(fd_, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout)) == 0);
+
+    sockaddr_un address{};
+    address.sun_family = AF_UNIX;
+    assert(path_.size() < sizeof(address.sun_path));
+    std::memcpy(address.sun_path, path_.data(), path_.size());
+    address.sun_path[path_.size()] = '\0';
+    auto address_length = static_cast<socklen_t>(offsetof(sockaddr_un, sun_path) + path_.size() + 1);
+    auto bind_result = bind(fd_, reinterpret_cast<const sockaddr *>(&address), address_length);
+    if (bind_result != 0) {
+      std::cerr << "Failed to bind " << path_ << ": " << std::strerror(errno) << std::endl;
+    }
+    assert(bind_result == 0);
+  }
+
+  UnixDatagramReceiver(const UnixDatagramReceiver &) = delete;
+  UnixDatagramReceiver &operator=(const UnixDatagramReceiver &) = delete;
+
+  ~UnixDatagramReceiver() {
+    if (fd_ >= 0) {
+      close(fd_);
+    }
+    unlink(path_.c_str());
+  }
+
+  std::vector<td::uint8> receive() const {
+    std::array<td::uint8, UpdateTap::MAX_DATAGRAM_SIZE + 1> buffer{};
+    auto size = recv(fd_, buffer.data(), buffer.size(), 0);
+    if (size < static_cast<ssize_t>(UpdateTap::HEADER_SIZE)) {
+      std::cerr << "Receive failed or short on " << path_ << ": size=" << size
+                << " error=" << std::strerror(errno) << std::endl;
+    }
+    assert(size >= static_cast<ssize_t>(UpdateTap::HEADER_SIZE));
+    assert(size <= static_cast<ssize_t>(UpdateTap::MAX_DATAGRAM_SIZE));
+    return {buffer.begin(), buffer.begin() + size};
+  }
+
+ private:
+  std::string path_;
+  int fd_{-1};
+};
+
+std::string make_socket_path(const char *suffix) {
+  return "/tmp/phenogram-update-tap-" + std::to_string(getpid()) + "-" + suffix + ".sock";
+}
+
+void validate_header(const std::vector<td::uint8> &frame, td::uint64 bot_id, td::uint32 update_id,
+                     td::uint32 expires_at, std::size_t total_length, std::size_t fragment_index,
+                     std::size_t fragment_count, std::size_t fragment_offset, std::size_t fragment_length,
+                     bool is_test_dc, td::uint8 frame_type = 1, td::uint64 reserved = 0) {
+  assert(std::memcmp(frame.data(), "PGUT", 4) == 0);
+  assert(frame[4] == 1);
+  assert(frame[5] == frame_type);
+  assert(frame[6] == (is_test_dc ? 1 : 0));
+  assert(frame[7] == UpdateTap::HEADER_SIZE);
+  assert(load_u64(frame.data() + 8) != 0);
+  assert(load_u64(frame.data() + 16) != 0);
+  assert(load_u64(frame.data() + 24) == bot_id);
+  assert(load_u32(frame.data() + 32) == update_id);
+  assert(load_u32(frame.data() + 36) == expires_at);
+  assert(load_u32(frame.data() + 40) == total_length);
+  assert(load_u32(frame.data() + 44) == fragment_offset);
+  assert(load_u16(frame.data() + 48) == fragment_index);
+  assert(load_u16(frame.data() + 50) == fragment_count);
+  assert(load_u32(frame.data() + 52) == fragment_length);
+  assert(load_u64(frame.data() + 56) == reserved);
+  assert(frame.size() == UpdateTap::HEADER_SIZE + fragment_length);
+}
+
+void send_datagram(const std::string &path, const std::vector<td::uint8> &frame) {
+  auto fd = socket(AF_UNIX, SOCK_DGRAM, 0);
+  assert(fd >= 0);
+  sockaddr_un address{};
+  address.sun_family = AF_UNIX;
+  assert(path.size() < sizeof(address.sun_path));
+  std::memcpy(address.sun_path, path.data(), path.size());
+  address.sun_path[path.size()] = '\0';
+  auto address_length = static_cast<socklen_t>(offsetof(sockaddr_un, sun_path) + path.size() + 1);
+  assert(sendto(fd, frame.data(), frame.size(), 0, reinterpret_cast<const sockaddr *>(&address), address_length) ==
+         static_cast<ssize_t>(frame.size()));
+  close(fd);
+}
+
+void test_managed_bot_lifecycle_is_durable_until_exact_ack() {
+  auto path = make_socket_path("managed-bot");
+  auto ack_path = make_socket_path("managed-bot-ack");
+  UnixDatagramReceiver receiver(path);
+  UpdateTap tap(path, ack_path);
+  auto tqueue = td::TQueue::create();
+  constexpr td::int32 now = 2000000000;
+
+  tap.queue_managed_bot_lifecycle(*tqueue, now, 1.0, 123456789, true, 444444444, 987654321);
+  auto frame = receiver.receive();
+  auto event_id = load_u32(frame.data() + 32);
+  auto expires_at = load_u32(frame.data() + 36);
+  auto delivery_nonce = load_u64(frame.data() + 56);
+  auto first_sequence = load_u64(frame.data() + 16);
+  assert(event_id != 0);
+  assert(expires_at == now + UpdateTap::MANAGED_LIFECYCLE_RETENTION_SECONDS);
+  assert(delivery_nonce != 0);
+  validate_header(frame, 123456789, event_id, expires_at, 16, 0, 1, 0, 16, true, 2, delivery_nonce);
+  assert(load_u64(frame.data() + UpdateTap::HEADER_SIZE) == 444444444);
+  assert(load_u64(frame.data() + UpdateTap::HEADER_SIZE + 8) == 987654321);
+  assert(tap.managed_lifecycle_pending_count(*tqueue) == 1);
+  assert(tap.managed_lifecycle_persisted_count() == 1);
+
+  // A lost frame or acknowledgement leaves the queue head intact. The replay
+  // keeps the durable event ID and nonce while assigning a fresh wire sequence.
+  tap.replay_managed_bot_lifecycle(*tqueue, now, 2.1);
+  auto replay = receiver.receive();
+  validate_header(replay, 123456789, event_id, expires_at, 16, 0, 1, 0, 16, true, 2, delivery_nonce);
+  assert(load_u64(replay.data() + 16) != first_sequence);
+  assert(tap.managed_lifecycle_replayed_count() == 2);
+
+  auto bad_ack = replay;
+  std::memcpy(bad_ack.data(), "PGUA", 4);
+  bad_ack.back() ^= 1;
+  send_datagram(ack_path, bad_ack);
+  tap.replay_managed_bot_lifecycle(*tqueue, now, 2.2);
+  assert(tap.managed_lifecycle_pending_count(*tqueue) == 1);
+  assert(tap.managed_lifecycle_ack_error_count() == 1);
+
+  auto good_ack = replay;
+  std::memcpy(good_ack.data(), "PGUA", 4);
+  send_datagram(ack_path, good_ack);
+  tap.replay_managed_bot_lifecycle(*tqueue, now, 2.3);
+  assert(tap.managed_lifecycle_pending_count(*tqueue) == 0);
+  assert(tap.managed_lifecycle_acked_count() == 1);
+}
+
+void test_single_frame_and_recovery() {
+  auto path = make_socket_path("single");
+  unlink(path.c_str());
+  UpdateTap tap(path);
+
+  const std::string payload = "\"message\":{\"message_id\":42}";
+  tap.send_update(123456789, false, 717, 2000000000, td::Slice(payload));
+  assert(tap.dropped_event_count() == 1);
+  assert(tap.error_count() == 1);
+
+  {
+    UnixDatagramReceiver receiver(path);
+    tap.send_update(123456789, false, 718, 2000000001, td::Slice(payload));
+    if (tap.sent_event_count() != 1) {
+      std::cerr << "Recovery send failed: errors=" << tap.error_count()
+                << " dropped=" << tap.dropped_event_count() << std::endl;
+    }
+    auto frame = receiver.receive();
+    validate_header(frame, 123456789, 718, 2000000001, payload.size(), 0, 1, 0, payload.size(), false);
+    assert(std::memcmp(frame.data() + UpdateTap::HEADER_SIZE, payload.data(), payload.size()) == 0);
+  }
+
+  assert(tap.sent_event_count() == 1);
+  assert(tap.sent_datagram_count() == 1);
+  assert(tap.dropped_event_count() == 1);
+}
+
+void test_managed_lifecycle_queue_is_bounded_and_expires_fail_open() {
+  auto path = make_socket_path("managed-bounded");
+  unlink(path.c_str());
+  UpdateTap tap(path);
+  auto tqueue = td::TQueue::create();
+  constexpr td::int32 now = 1000000000;
+  for (std::size_t i = 0; i < UpdateTap::MAX_MANAGED_LIFECYCLE_EVENTS; i++) {
+    tap.queue_managed_bot_lifecycle(*tqueue, now, 1.0, 100, false, 200,
+                                    static_cast<td::uint64>(300 + i));
+  }
+  assert(tap.managed_lifecycle_pending_count(*tqueue) == UpdateTap::MAX_MANAGED_LIFECYCLE_EVENTS);
+  tap.queue_managed_bot_lifecycle(*tqueue, now, 1.0, 100, false, 200, 999999);
+  assert(tap.managed_lifecycle_pending_count(*tqueue) == UpdateTap::MAX_MANAGED_LIFECYCLE_EVENTS);
+  assert(tap.managed_lifecycle_overflow_count() == 1);
+
+  tap.replay_managed_bot_lifecycle(*tqueue, now + UpdateTap::MANAGED_LIFECYCLE_RETENTION_SECONDS + 1, 2.1);
+  assert(tap.managed_lifecycle_pending_count(*tqueue) == 0);
+  assert(tap.managed_lifecycle_expired_count() == UpdateTap::MAX_MANAGED_LIFECYCLE_EVENTS);
+}
