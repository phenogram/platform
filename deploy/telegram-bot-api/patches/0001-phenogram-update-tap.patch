+#if !TD_DARWIN
+void test_fragmentation() {
+  auto path = make_socket_path("fragmentation");
+  UnixDatagramReceiver receiver(path);
+  UpdateTap tap(path);
+
+  std::string payload(UpdateTap::MAX_FRAGMENT_PAYLOAD_SIZE + 4096, '\0');
+  for (std::size_t i = 0; i < payload.size(); i++) {
+    payload[i] = static_cast<char>('a' + (i % 23));
+  }
+  const std::size_t expected_fragment_count =
+      (payload.size() + UpdateTap::MAX_FRAGMENT_PAYLOAD_SIZE - 1) / UpdateTap::MAX_FRAGMENT_PAYLOAD_SIZE;
+  const std::size_t maximum_fragment_count =
+      (UpdateTap::MAX_UPDATE_PAYLOAD_SIZE + UpdateTap::MAX_FRAGMENT_PAYLOAD_SIZE - 1) /
+      UpdateTap::MAX_FRAGMENT_PAYLOAD_SIZE;
+  assert(expected_fragment_count == 2);
+  assert(maximum_fragment_count == 9);
+  std::vector<std::vector<td::uint8>> frames;
+  frames.reserve(expected_fragment_count);
+  std::thread receiver_thread([&] {
+    for (std::size_t fragment_index = 0; fragment_index < expected_fragment_count; fragment_index++) {
+      frames.push_back(receiver.receive());
+    }
+  });
+  tap.send_update(987654321, true, 1999999999, 2000000100, td::Slice(payload));
+  receiver_thread.join();
+
+  std::string reconstructed(payload.size(), '\0');
+  td::uint64 producer_id = 0;
+  td::uint64 sequence = 0;
+  for (std::size_t fragment_index = 0; fragment_index < expected_fragment_count; fragment_index++) {
+    const auto &frame = frames[fragment_index];
+    auto fragment_offset = fragment_index * UpdateTap::MAX_FRAGMENT_PAYLOAD_SIZE;
+    auto fragment_length = std::min(UpdateTap::MAX_FRAGMENT_PAYLOAD_SIZE, payload.size() - fragment_offset);
+    validate_header(frame, 987654321, 1999999999, 2000000100, payload.size(), fragment_index,
+                    expected_fragment_count, fragment_offset, fragment_length, true);
+    if (fragment_index == 0) {
+      producer_id = load_u64(frame.data() + 8);
+      sequence = load_u64(frame.data() + 16);
+    } else {
+      assert(load_u64(frame.data() + 8) == producer_id);
+      assert(load_u64(frame.data() + 16) == sequence);
+    }
+    std::memcpy(&reconstructed[fragment_offset], frame.data() + UpdateTap::HEADER_SIZE, fragment_length);
+  }
+  assert(reconstructed == payload);
+  assert(tap.sent_event_count() == 1);
+  assert(tap.sent_datagram_count() == expected_fragment_count);
+  assert(tap.dropped_event_count() == 0);
+  assert(tap.error_count() == 0);
+  std::cout << "UpdateTap fragmentation: exercised_bytes=" << payload.size()
+            << " exercised_fragments=" << expected_fragment_count
+            << " max_bytes=" << UpdateTap::MAX_UPDATE_PAYLOAD_SIZE
+            << " max_fragments=" << maximum_fragment_count << std::endl;
+}
+#endif
+
+void test_oversize_is_dropped() {
+  auto path = make_socket_path("oversize");
+  UnixDatagramReceiver receiver(path);
+  UpdateTap tap(path);
+  std::string payload(UpdateTap::MAX_UPDATE_PAYLOAD_SIZE + 1, 'x');
+  tap.send_update(1, false, 1, 1, td::Slice(payload));
+  assert(tap.sent_event_count() == 0);
+  assert(tap.sent_datagram_count() == 0);
+  assert(tap.dropped_event_count() == 1);
+  assert(tap.error_count() == 1);
+}
+
+void test_backpressure_never_blocks() {
+  auto path = make_socket_path("backpressure");
+  UnixDatagramReceiver receiver(path, true);
+  UpdateTap tap(path);
+  std::string payload(UpdateTap::MAX_FRAGMENT_PAYLOAD_SIZE, 'b');
+
+  auto started_at = std::chrono::steady_clock::now();
+  constexpr td::uint64 EVENT_COUNT = 1000;
+  for (td::uint64 i = 0; i < EVENT_COUNT; i++) {
+    tap.send_update(2, false, static_cast<td::uint32>(i + 1), 2000000000, td::Slice(payload));
+  }
+  auto elapsed = std::chrono::steady_clock::now() - started_at;
+
+  assert(tap.sent_event_count() + tap.dropped_event_count() == EVENT_COUNT);
+  assert(tap.dropped_event_count() > 0);
+  assert(tap.error_count() >= tap.dropped_event_count());
+  assert(elapsed < std::chrono::seconds(3));
+  std::cout << "UpdateTap backpressure: attempted=" << EVENT_COUNT
+            << " sent=" << tap.sent_event_count() << " dropped=" << tap.dropped_event_count()
+            << " errors=" << tap.error_count() << " elapsed_us="
+            << std::chrono::duration_cast<std::chrono::microseconds>(elapsed).count() << std::endl;
+}
+
+#endif
+
+}  // namespace
+
+int main() {
+#if !TD_WINDOWS
+  test_gateway_drain_fence_orders_late_queries();
+  test_single_frame_and_recovery();
+  test_managed_bot_lifecycle_is_durable_until_exact_ack();
+  test_managed_lifecycle_queue_is_bounded_and_expires_fail_open();
+#if !TD_DARWIN
+  test_fragmentation();
+#endif
+  test_oversize_is_dropped();
+  test_backpressure_never_blocks();
+  std::cout << "UpdateTap tests passed" << std::endl;
+#endif
+  return 0;
+}
