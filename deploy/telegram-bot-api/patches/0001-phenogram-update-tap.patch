+namespace {
+
+constexpr td::uint8 FRAME_VERSION = 1;
+constexpr td::uint8 FRAME_TYPE_UPDATE = 1;
+constexpr td::uint8 FRAME_TYPE_MANAGED_BOT_LIFECYCLE = 2;
+constexpr td::uint8 FLAG_TEST_DC = 1;
+constexpr std::size_t MANAGED_LIFECYCLE_RECORD_SIZE = 33;
+constexpr std::size_t MANAGED_LIFECYCLE_PAYLOAD_SIZE = 16;
+constexpr std::size_t ACK_FRAME_SIZE = UpdateTap::HEADER_SIZE + MANAGED_LIFECYCLE_PAYLOAD_SIZE;
+constexpr double MANAGED_LIFECYCLE_REPLAY_INTERVAL = 1.0;
+constexpr std::size_t MAX_ACKS_PER_TICK = 64;
+
+void store_u16(td::uint8 *destination, td::uint16 value) noexcept {
+  destination[0] = static_cast<td::uint8>(value >> 8);
+  destination[1] = static_cast<td::uint8>(value);
+}
+
+void store_u32(td::uint8 *destination, td::uint32 value) noexcept {
+  destination[0] = static_cast<td::uint8>(value >> 24);
+  destination[1] = static_cast<td::uint8>(value >> 16);
+  destination[2] = static_cast<td::uint8>(value >> 8);
+  destination[3] = static_cast<td::uint8>(value);
+}
+
+void store_u64(td::uint8 *destination, td::uint64 value) noexcept {
+  store_u32(destination, static_cast<td::uint32>(value >> 32));
+  store_u32(destination + 4, static_cast<td::uint32>(value));
+}
+
+td::uint32 load_u32(const td::uint8 *source) noexcept {
+  return (static_cast<td::uint32>(source[0]) << 24) | (static_cast<td::uint32>(source[1]) << 16) |
+         (static_cast<td::uint32>(source[2]) << 8) | source[3];
+}
+
+td::uint64 load_u64(const td::uint8 *source) noexcept {
+  return (static_cast<td::uint64>(load_u32(source)) << 32) | load_u32(source + 4);
+}
+
+td::uint64 mix_u64(td::uint64 value) noexcept {
+  value += 0x9e3779b97f4a7c15ULL;
+  value = (value ^ (value >> 30)) * 0xbf58476d1ce4e5b9ULL;
+  value = (value ^ (value >> 27)) * 0x94d049bb133111ebULL;
+  return value ^ (value >> 31);
+}
+
+td::uint64 make_producer_instance_id() noexcept {
+  auto ticks = static_cast<td::uint64>(
+      std::chrono::high_resolution_clock::now().time_since_epoch().count());
+#if !TD_WINDOWS
+  ticks ^= static_cast<td::uint64>(getpid()) << 32;
+#endif
+  auto result = mix_u64(ticks);
+  return result == 0 ? 1 : result;
+}
+
+struct ManagedLifecycleRecord {
+  bool is_test_dc{false};
+  td::uint64 parent_bot_id{0};
+  td::uint64 owner_user_id{0};
+  td::uint64 child_bot_id{0};
+  td::uint64 delivery_nonce{0};
+};
+
+td::string encode_managed_lifecycle_record(const ManagedLifecycleRecord &record) {
+  std::array<td::uint8, MANAGED_LIFECYCLE_RECORD_SIZE> bytes{};
+  bytes[0] = record.is_test_dc ? FLAG_TEST_DC : 0;
+  store_u64(bytes.data() + 1, record.parent_bot_id);
+  store_u64(bytes.data() + 9, record.owner_user_id);
+  store_u64(bytes.data() + 17, record.child_bot_id);
+  store_u64(bytes.data() + 25, record.delivery_nonce);
+  return td::string(reinterpret_cast<const char *>(bytes.data()), bytes.size());
+}
+
+bool decode_managed_lifecycle_record(td::Slice data, ManagedLifecycleRecord &record) noexcept {
+  if (data.size() != MANAGED_LIFECYCLE_RECORD_SIZE) {
+    return false;
+  }
+  const auto *bytes = reinterpret_cast<const td::uint8 *>(data.data());
+  if ((bytes[0] & ~FLAG_TEST_DC) != 0) {
+    return false;
+  }
+  record.is_test_dc = (bytes[0] & FLAG_TEST_DC) != 0;
+  record.parent_bot_id = load_u64(bytes + 1);
+  record.owner_user_id = load_u64(bytes + 9);
+  record.child_bot_id = load_u64(bytes + 17);
+  record.delivery_nonce = load_u64(bytes + 25);
+  return record.parent_bot_id != 0 && record.owner_user_id != 0 && record.child_bot_id != 0 &&
+         record.delivery_nonce != 0;
+}
+
+#if !TD_WINDOWS
+bool set_nonblocking_close_on_exec(int fd) noexcept {
+  auto status_flags = fcntl(fd, F_GETFL, 0);
+  auto descriptor_flags = fcntl(fd, F_GETFD, 0);
+  return status_flags >= 0 && descriptor_flags >= 0 && fcntl(fd, F_SETFL, status_flags | O_NONBLOCK) >= 0 &&
+         fcntl(fd, F_SETFD, descriptor_flags | FD_CLOEXEC) >= 0;
+}
+#endif
+
+}  // namespace
+
+UpdateTap::UpdateTap(td::string socket_path, td::string ack_socket_path) noexcept
+    : socket_path_(std::move(socket_path))
+    , ack_socket_path_(std::move(ack_socket_path))
+    , producer_instance_id_(make_producer_instance_id()) {
+#if !TD_WINDOWS
+  if (socket_path_.empty() || socket_path_.size() >= sizeof(sockaddr_un::sun_path)) {
+    error_count_.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+
+  fd_ = socket(AF_UNIX, SOCK_DGRAM, 0);
+  if (fd_ < 0) {
+    error_count_.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+
+  if (!set_nonblocking_close_on_exec(fd_)) {
+    close(fd_);
+    fd_ = -1;
+    error_count_.fetch_add(1, std::memory_order_relaxed);
+  }
+
+  if (ack_socket_path_.empty()) {
+    return;
+  }
+  if (ack_socket_path_.size() >= sizeof(sockaddr_un::sun_path)) {
+    managed_lifecycle_ack_error_count_.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  struct stat path_stat {};
+  if (lstat(ack_socket_path_.c_str(), &path_stat) == 0) {
+    if (!S_ISSOCK(path_stat.st_mode) || unlink(ack_socket_path_.c_str()) != 0) {
+      managed_lifecycle_ack_error_count_.fetch_add(1, std::memory_order_relaxed);
+      return;
+    }
+  } else if (errno != ENOENT) {
+    managed_lifecycle_ack_error_count_.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+
+  ack_fd_ = socket(AF_UNIX, SOCK_DGRAM, 0);
+  if (ack_fd_ < 0 || !set_nonblocking_close_on_exec(ack_fd_)) {
+    if (ack_fd_ >= 0) {
+      close(ack_fd_);
+      ack_fd_ = -1;
+    }
+    managed_lifecycle_ack_error_count_.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  sockaddr_un ack_address{};
+  ack_address.sun_family = AF_UNIX;
+  std::memcpy(ack_address.sun_path, ack_socket_path_.data(), ack_socket_path_.size());
+  ack_address.sun_path[ack_socket_path_.size()] = '\0';
+  auto ack_address_length =
+      static_cast<socklen_t>(offsetof(sockaddr_un, sun_path) + ack_socket_path_.size() + 1);
+  if (bind(ack_fd_, reinterpret_cast<const sockaddr *>(&ack_address), ack_address_length) != 0 ||
+      chmod(ack_socket_path_.c_str(), 0660) != 0) {
+    close(ack_fd_);
+    ack_fd_ = -1;
+    unlink(ack_socket_path_.c_str());
+    managed_lifecycle_ack_error_count_.fetch_add(1, std::memory_order_relaxed);
+  }
+#else
+  error_count_.fetch_add(1, std::memory_order_relaxed);
+#endif
+}
+
+UpdateTap::~UpdateTap() {
+#if !TD_WINDOWS
+  if (fd_ >= 0) {
+    close(fd_);
+  }
+  if (ack_fd_ >= 0) {
+    close(ack_fd_);
+    unlink(ack_socket_path_.c_str());
+  }
+#endif
+}
+
+void UpdateTap::send_update(td::uint64 bot_id, bool is_test_dc, td::uint32 update_id, td::uint32 expires_at,
+                            td::Slice payload) noexcept {
+  send_event(FRAME_TYPE_UPDATE, bot_id, is_test_dc, update_id, expires_at, 0, payload);
+}
+
+void UpdateTap::queue_managed_bot_lifecycle(td::TQueue &tqueue, td::int32 unix_time_now, double monotonic_now,
+                                            td::uint64 parent_bot_id, bool is_test_dc, td::uint64 owner_user_id,
+                                            td::uint64 child_bot_id) noexcept {
+  if (parent_bot_id == 0 || owner_user_id == 0 || child_bot_id == 0 || unix_time_now <= 0) {
+    managed_lifecycle_persistence_error_count_.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  if (tqueue.get_size(MANAGED_LIFECYCLE_QUEUE_ID) >= MAX_MANAGED_LIFECYCLE_EVENTS) {
+    managed_lifecycle_overflow_count_.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+
+  lifecycle_nonce_sequence_++;
+  auto delivery_nonce = mix_u64(producer_instance_id_ ^ lifecycle_nonce_sequence_) &
+                        static_cast<td::uint64>(std::numeric_limits<td::int64>::max());
+  if (delivery_nonce == 0) {
+    delivery_nonce = 1;
+  }
+  ManagedLifecycleRecord record{is_test_dc, parent_bot_id, owner_user_id, child_bot_id, delivery_nonce};
+  auto expires_at =
+      unix_time_now > std::numeric_limits<td::int32>::max() - MANAGED_LIFECYCLE_RETENTION_SECONDS
+          ? std::numeric_limits<td::int32>::max()
+          : unix_time_now + MANAGED_LIFECYCLE_RETENTION_SECONDS;
+  auto result = tqueue.push(MANAGED_LIFECYCLE_QUEUE_ID, encode_managed_lifecycle_record(record), expires_at, 0,
+                            td::TQueue::EventId());
+  if (result.is_error()) {
+    managed_lifecycle_persistence_error_count_.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  managed_lifecycle_persisted_count_.fetch_add(1, std::memory_order_relaxed);
+  replay_managed_bot_lifecycle(tqueue, unix_time_now, monotonic_now);
+}
+
+void UpdateTap::replay_managed_bot_lifecycle(td::TQueue &tqueue, td::int32 unix_time_now,
+                                             double monotonic_now) noexcept {
+#if !TD_WINDOWS
+  drain_managed_lifecycle_acks(tqueue, unix_time_now);
+  if (monotonic_now < next_lifecycle_replay_at_) {
+    return;
+  }
+  emit_managed_lifecycle_head(tqueue, unix_time_now, monotonic_now);
+#else
+  static_cast<void>(tqueue);
+  static_cast<void>(unix_time_now);
+  static_cast<void>(monotonic_now);
+#endif
+}
+
+td::uint64 UpdateTap::send_event(td::uint8 frame_type, td::uint64 bot_id, bool is_test_dc, td::uint32 update_id,
+                                 td::uint32 expires_at, td::uint64 reserved, td::Slice payload) noexcept {
+#if !TD_WINDOWS
+  if (fd_ < 0 || payload.size() > MAX_UPDATE_PAYLOAD_SIZE) {
+    error_count_.fetch_add(1, std::memory_order_relaxed);
+    dropped_event_count_.fetch_add(1, std::memory_order_relaxed);
+    return 0;
+  }
+
+  sockaddr_un address{};
+  address.sun_family = AF_UNIX;
+  std::memcpy(address.sun_path, socket_path_.data(), socket_path_.size());
+  address.sun_path[socket_path_.size()] = '\0';
+  auto address_length = static_cast<socklen_t>(offsetof(sockaddr_un, sun_path) + socket_path_.size() + 1);
+
+  auto total_length = payload.size();
+  auto fragment_count = td::max<std::size_t>(1, (total_length + MAX_FRAGMENT_PAYLOAD_SIZE - 1) /
+                                                   MAX_FRAGMENT_PAYLOAD_SIZE);
+  auto event_sequence = event_sequence_.fetch_add(1, std::memory_order_relaxed) + 1;
+  std::array<td::uint8, HEADER_SIZE> header;
+
+  for (std::size_t fragment_index = 0; fragment_index < fragment_count; fragment_index++) {
+    auto fragment_offset = fragment_index * MAX_FRAGMENT_PAYLOAD_SIZE;
+    auto fragment_length = td::min(MAX_FRAGMENT_PAYLOAD_SIZE, total_length - fragment_offset);
+
+    header[0] = 'P';
+    header[1] = 'G';
+    header[2] = 'U';
+    header[3] = 'T';
+    header[4] = FRAME_VERSION;
+    header[5] = frame_type;
+    header[6] = is_test_dc ? FLAG_TEST_DC : 0;
+    header[7] = static_cast<td::uint8>(HEADER_SIZE);
+    store_u64(header.data() + 8, producer_instance_id_);
+    store_u64(header.data() + 16, event_sequence);
+    store_u64(header.data() + 24, bot_id);
+    store_u32(header.data() + 32, update_id);
+    store_u32(header.data() + 36, expires_at);
+    store_u32(header.data() + 40, static_cast<td::uint32>(total_length));
+    store_u32(header.data() + 44, static_cast<td::uint32>(fragment_offset));
+    store_u16(header.data() + 48, static_cast<td::uint16>(fragment_index));
+    store_u16(header.data() + 50, static_cast<td::uint16>(fragment_count));
+    store_u32(header.data() + 52, static_cast<td::uint32>(fragment_length));
+    store_u64(header.data() + 56, reserved);
+
+    auto datagram_length = HEADER_SIZE + fragment_length;
+    iovec vectors[2]{};
+    vectors[0].iov_base = header.data();
+    vectors[0].iov_len = header.size();
+    vectors[1].iov_base =
+        fragment_length == 0 ? nullptr : const_cast<char *>(payload.data() + fragment_offset);
+    vectors[1].iov_len = fragment_length;
+
+    msghdr message{};
+    message.msg_name = &address;
+    message.msg_namelen = address_length;
+    message.msg_iov = vectors;
+    message.msg_iovlen = fragment_length == 0 ? 1 : 2;
+#ifdef MSG_NOSIGNAL
+    constexpr int SEND_FLAGS = MSG_DONTWAIT | MSG_NOSIGNAL;
+#else
+    constexpr int SEND_FLAGS = MSG_DONTWAIT;
+#endif
+    auto sent_size = sendmsg(fd_, &message, SEND_FLAGS);
+    if (sent_size < 0 || static_cast<std::size_t>(sent_size) != datagram_length) {
+      error_count_.fetch_add(1, std::memory_order_relaxed);
+      dropped_event_count_.fetch_add(1, std::memory_order_relaxed);
+      return 0;
+    }
+    sent_datagram_count_.fetch_add(1, std::memory_order_relaxed);
+  }
+  sent_event_count_.fetch_add(1, std::memory_order_relaxed);
+  return event_sequence;
+#else
+  static_cast<void>(frame_type);
+  static_cast<void>(bot_id);
+  static_cast<void>(is_test_dc);
+  static_cast<void>(update_id);
+  static_cast<void>(expires_at);
+  static_cast<void>(reserved);
+  static_cast<void>(payload);
+  error_count_.fetch_add(1, std::memory_order_relaxed);
+  dropped_event_count_.fetch_add(1, std::memory_order_relaxed);
+  return 0;
+#endif
+}
+
+bool UpdateTap::emit_managed_lifecycle_head(td::TQueue &tqueue, td::int32 unix_time_now,
+                                            double monotonic_now) noexcept {
+#if !TD_WINDOWS
+  auto size_before = tqueue.get_size(MANAGED_LIFECYCLE_QUEUE_ID);
+  if (size_before == 0) {
+    inflight_event_sequence_ = 0;
+    inflight_event_id_ = 0;
+    return false;
+  }
+  auto head = tqueue.get_head(MANAGED_LIFECYCLE_QUEUE_ID);
+  td::TQueue::Event event_buffer[1];
+  td::MutableSpan<td::TQueue::Event> events(event_buffer, 1);
+  auto result = tqueue.get(MANAGED_LIFECYCLE_QUEUE_ID, head, false, unix_time_now, events);
+  auto size_after = tqueue.get_size(MANAGED_LIFECYCLE_QUEUE_ID);
+  if (size_after < size_before) {
+    managed_lifecycle_expired_count_.fetch_add(size_before - size_after, std::memory_order_relaxed);
+  }
+  if (result.is_error()) {
+    managed_lifecycle_persistence_error_count_.fetch_add(1, std::memory_order_relaxed);
+    return false;
+  }
+  if (events.empty()) {
+    inflight_event_sequence_ = 0;
+    inflight_event_id_ = 0;
+    return false;
+  }
+
+  ManagedLifecycleRecord record;
+  if (!decode_managed_lifecycle_record(events[0].data, record)) {
+    managed_lifecycle_persistence_error_count_.fetch_add(1, std::memory_order_relaxed);
+    tqueue.forget(MANAGED_LIFECYCLE_QUEUE_ID, events[0].id);
+    inflight_event_sequence_ = 0;
+    inflight_event_id_ = 0;
+    next_lifecycle_replay_at_ = monotonic_now + MANAGED_LIFECYCLE_REPLAY_INTERVAL;
+    return false;
+  }
+
+  std::array<td::uint8, MANAGED_LIFECYCLE_PAYLOAD_SIZE> payload{};
+  store_u64(payload.data(), record.owner_user_id);
+  store_u64(payload.data() + 8, record.child_bot_id);
+  auto sequence = send_event(FRAME_TYPE_MANAGED_BOT_LIFECYCLE, record.parent_bot_id, record.is_test_dc,
+                             static_cast<td::uint32>(events[0].id.value()),
+                             static_cast<td::uint32>(events[0].expires_at), record.delivery_nonce,
+                             td::Slice(reinterpret_cast<const char *>(payload.data()), payload.size()));
+  next_lifecycle_replay_at_ = monotonic_now + MANAGED_LIFECYCLE_REPLAY_INTERVAL;
+  if (sequence == 0) {
+    return false;
+  }
+  inflight_event_sequence_ = sequence;
+  inflight_event_id_ = events[0].id.value();
+  managed_lifecycle_replayed_count_.fetch_add(1, std::memory_order_relaxed);
+  return true;
+#else
+  static_cast<void>(tqueue);
+  static_cast<void>(unix_time_now);
+  static_cast<void>(monotonic_now);
+  return false;
+#endif
+}
+
+void UpdateTap::drain_managed_lifecycle_acks(td::TQueue &tqueue, td::int32 unix_time_now) noexcept {
+#if !TD_WINDOWS
+  if (ack_fd_ < 0) {
+    return;
+  }
+  for (std::size_t ack_index = 0; ack_index < MAX_ACKS_PER_TICK; ack_index++) {
+    std::array<td::uint8, ACK_FRAME_SIZE + 1> ack{};
+    auto received = recv(ack_fd_, ack.data(), ack.size(), MSG_DONTWAIT);
+    if (received < 0) {
+      if (errno != EAGAIN && errno != EWOULDBLOCK) {
+        managed_lifecycle_ack_error_count_.fetch_add(1, std::memory_order_relaxed);
+      }
+      return;
+    }
+    if (static_cast<std::size_t>(received) != ACK_FRAME_SIZE || std::memcmp(ack.data(), "PGUA", 4) != 0 ||
+        ack[4] != FRAME_VERSION || ack[5] != FRAME_TYPE_MANAGED_BOT_LIFECYCLE ||
+        (ack[6] & ~FLAG_TEST_DC) != 0 || ack[7] != HEADER_SIZE || load_u64(ack.data() + 8) != producer_instance_id_ ||
+        load_u64(ack.data() + 16) != inflight_event_sequence_ ||
+        load_u32(ack.data() + 32) != static_cast<td::uint32>(inflight_event_id_) ||
+        load_u32(ack.data() + 40) != MANAGED_LIFECYCLE_PAYLOAD_SIZE || load_u32(ack.data() + 44) != 0 ||
+        ack[48] != 0 || ack[49] != 0 || ack[50] != 0 || ack[51] != 1 ||
+        load_u32(ack.data() + 52) != MANAGED_LIFECYCLE_PAYLOAD_SIZE) {
+      managed_lifecycle_ack_error_count_.fetch_add(1, std::memory_order_relaxed);
+      continue;
+    }
+
+    auto size_before = tqueue.get_size(MANAGED_LIFECYCLE_QUEUE_ID);
+    if (size_before == 0) {
+      managed_lifecycle_ack_error_count_.fetch_add(1, std::memory_order_relaxed);
+      continue;
+    }
+    auto head = tqueue.get_head(MANAGED_LIFECYCLE_QUEUE_ID);
+    td::TQueue::Event event_buffer[1];
+    td::MutableSpan<td::TQueue::Event> events(event_buffer, 1);
+    auto result = tqueue.get(MANAGED_LIFECYCLE_QUEUE_ID, head, false, unix_time_now, events);
+    auto size_after = tqueue.get_size(MANAGED_LIFECYCLE_QUEUE_ID);
+    if (size_after < size_before) {
+      managed_lifecycle_expired_count_.fetch_add(size_before - size_after, std::memory_order_relaxed);
+    }
+    ManagedLifecycleRecord record;
+    if (result.is_error() || events.empty() || events[0].id.value() != inflight_event_id_ ||
+        !decode_managed_lifecycle_record(events[0].data, record) ||
+        ack[6] != (record.is_test_dc ? FLAG_TEST_DC : 0) || load_u64(ack.data() + 24) != record.parent_bot_id ||
+        load_u32(ack.data() + 36) != static_cast<td::uint32>(events[0].expires_at) ||
+        load_u64(ack.data() + 56) != record.delivery_nonce ||
+        load_u64(ack.data() + HEADER_SIZE) != record.owner_user_id ||
+        load_u64(ack.data() + HEADER_SIZE + 8) != record.child_bot_id) {
+      managed_lifecycle_ack_error_count_.fetch_add(1, std::memory_order_relaxed);
+      continue;
+    }
+
+    tqueue.forget(MANAGED_LIFECYCLE_QUEUE_ID, events[0].id);
+    inflight_event_sequence_ = 0;
+    inflight_event_id_ = 0;
+    next_lifecycle_replay_at_ = 0.0;
+    managed_lifecycle_acked_count_.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+#else
+  static_cast<void>(tqueue);
+  static_cast<void>(unix_time_now);
+#endif
+}
+
